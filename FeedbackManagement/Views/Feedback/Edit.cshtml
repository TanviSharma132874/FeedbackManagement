@model Feedback
@{
    ViewData["Title"] = "Edit Feedback";
}

<h2 class="mb-3">Edit Feedback</h2>

<div class="card shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm("Edit", "Feedback", new { id = Model.Id }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.ValidationSummary(false, "Please correct the following errors:", new { @class = "alert alert-danger" })

            @await Html.PartialAsync("_FeedbackFields", Model)

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                @Html.ActionLink("Cancel", "Index", "Feedback", new { }, new { @class = "btn btn-outline-secondary ms-2" })
            </div>
        }
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
