@model Feedback
@{
    ViewData["Title"] = "Delete Feedback";
}

<h2 class="mb-3">Delete Feedback</h2>

<div class="alert alert-danger">Are you sure you want to delete this feedback?</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FullName)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.FullName)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Subject)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Subject)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Category)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Category)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Rating)</dt>
            <dd class="col-sm-9">@await Html.PartialAsync("_RatingStars", Model.Rating ?? 0)</dd>
        </dl>
    </div>
</div>

@using (Html.BeginForm("Delete", "Feedback", new { id = Model.Id }, FormMethod.Post, null, new { @class = "mt-3" }))
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    @Html.ActionLink("Cancel", "Index", "Feedback", new { }, new { @class = "btn btn-outline-secondary ms-2" })
}
