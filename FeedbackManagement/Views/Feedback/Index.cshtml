@model FeedbackListViewModel
@{
    ViewData["Title"] = "All Feedback";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Feedback Management</h2>
    @Html.ActionLink("+ Give Feedback", "Create", "Feedback", new { }, new { @class = "btn btn-primary" })
</div>

@await Html.PartialAsync("_StatsCards", Model.Stats)

@await Html.PartialAsync("_Filter", Model)

<div class="card shadow-sm mb-4">
    <div class="card-body">
        @await Html.PartialAsync("_FeedbackTable", Model.Items)
    </div>
</div>

<h5 class="mb-3">Latest Feedback</h5>
<div id="latestFeedback" data-url="@Url.Action("Latest", "Feedback")">
    <span class="text-muted">Loading...</span>
</div>

@section Scripts {
    <script>
        (function () {
            var box = document.getElementById("latestFeedback");
            fetch(box.getAttribute("data-url"))
                .then(function (response) { return response.text(); })
                .then(function (html) { box.innerHTML = html; })
                .catch(function () { box.innerHTML = "<span class='text-danger'>Could not load latest feedback.</span>"; });
        })();
    </script>
}
