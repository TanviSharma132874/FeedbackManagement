<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Feedback Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary">
            <div class="container">
                @Html.ActionLink("Feedback Management", "Index", "Feedback", new { }, new { @class = "navbar-brand fw-bold" })
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        @Html.ActionLink("All Feedback", "Index", "Feedback", new { }, new { @class = "nav-link" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Give Feedback", "Create", "Feedback", new { }, new { @class = "nav-link" })
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @await Html.PartialAsync("_Notification")
        @RenderBody()
    </main>

    <footer class="border-top bg-white py-3 mt-4">
        <div class="container text-muted small">
            &copy; @DateTime.Now.Year Feedback Management Module &middot; ASP.NET Core MVC (.NET 10)
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
